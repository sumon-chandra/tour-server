<!doctype html>
<html lang="en">

<head>
   <meta charset="utf-8">
   <title>One-Time Password</title>
   <meta name="viewport" content="width=device-width, initial-scale=1">
   <style>
      @media (max-width: 600px) {
         .container {
            width: 100% !important;
         }

         .otp {
            font-size: 26px !important;
            letter-spacing: 6px !important;
         }
      }
   </style>
</head>

<body style="margin:0;padding:0;background:#f4f6f8;">
   <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#f4f6f8;">
      <tr>
         <td align="center" style="padding:24px;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" class="container"
               style="width:600px;max-width:600px;background:#ffffff;border-radius:8px;overflow:hidden;">

               <!-- Header -->
               <tr>
                  <td align="center" style="background:#0b5cff;padding:20px;">
                     <div style="font-family:Arial,Helvetica,sans-serif;font-size:20px;color:#ffffff;font-weight:700;">
                        OTP Verification
                     </div>
                  </td>
               </tr>

               <!-- Body -->
               <tr>
                  <td
                     style="padding:32px;font-family:Arial,Helvetica,sans-serif;font-size:16px;color:#111827;line-height:24px;">
                     <p style="margin:0 0 16px;">Hi <%= name %>,</p>
                     <p style="margin:0 0 24px;">Use the following one-time password (OTP) to complete your
                        verification:</p>

                     <!-- OTP block -->
                     <div style="text-align:center;margin:24px 0;">
                        <div class="otp" style="display:inline-block;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;padding:16px 24px;
                       font-family:'Courier New',Consolas,monospace;font-size:28px;letter-spacing:8px;color:#111827;">
                           <%= otp %>
                        </div>
                     </div>

                     <p style="margin:0;color:#6b7280;font-size:14px;line-height:21px;">
                        If you did not request this code, you can safely ignore this email.
                     </p>
                  </td>
               </tr>

               <!-- Footer -->
               <tr>
                  <td align="center"
                     style="padding:16px;border-top:1px solid #e5e7eb;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#9aa3b2;">
                     © <%= new Date().getFullYear() %> Your Company. All rights reserved.
                  </td>
               </tr>
            </table>
         </td>
      </tr>
   </table>
</body>

</html>