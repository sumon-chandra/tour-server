<!doctype html>
<html lang="en">

<head>
   <meta charset="utf-8">
   <title>Invoice <%= transactionId %>
   </title>
   <meta name="viewport" content="width=device-width, initial-scale=1">
   <style>
      body {
         margin: 0;
         padding: 0;
         background: #f4f6f8;
         font-family: Arial, Helvetica, sans-serif;
      }

      .container {
         width: 100%;
         max-width: 640px;
         margin: 0 auto;
         background: #ffffff;
         border-radius: 8px;
         overflow: hidden;
      }

      .header {
         background: #0b5cff;
         color: #ffffff;
         padding: 20px;
         text-align: center;
         font-size: 20px;
         font-weight: 600;
      }

      .section {
         padding: 24px;
      }

      .row {
         display: flex;
         justify-content: space-between;
         margin-bottom: 12px;
      }

      .label {
         color: #6b7280;
         font-size: 14px;
      }

      .value {
         font-size: 15px;
         color: #111827;
      }

      .table {
         width: 100%;
         border-collapse: collapse;
         margin-top: 20px;
      }

      .table th,
      .table td {
         border: 1px solid #e5e7eb;
         padding: 12px;
         text-align: left;
      }

      .table th {
         background: #f9fafb;
         font-size: 14px;
         color: #374151;
      }

      .table td {
         font-size: 14px;
         color: #111827;
      }

      .total {
         text-align: right;
         font-weight: 700;
         font-size: 16px;
         padding-top: 12px;
      }

      .footer {
         padding: 16px;
         text-align: center;
         font-size: 12px;
         color: #9aa3b2;
         border-top: 1px solid #e5e7eb;
      }

      @media (max-width:600px) {
         .row {
            flex-direction: column;
            margin-bottom: 16px;
         }
      }
   </style>
</head>

<body>
   <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
      style="background:#f4f6f8;padding:24px;">
      <tr>
         <td align="center">
            <div class="container">
               <!-- Header -->
               <div class="header">Invoice</div>

               <!-- Invoice Info -->
               <div class="section">
                  <div class="row">
                     <div class="label">Transaction ID:</div>
                     <div class="value">
                        <%= transactionId %>
                     </div>
                  </div>
                  <div class="row">
                     <div class="label">Booking Date:</div>
                     <div class="value">
                        <%= bookingDate.toDateString() %>
                     </div>
                  </div>
                  <div class="row">
                     <div class="label">Customer Name:</div>
                     <div class="value">
                        <%= userName %>
                     </div>
                  </div>
               </div>

               <!-- Booking Details Table -->
               <div class="section">
                  <table class="table">
                     <thead>
                        <tr>
                           <th>Tour Title</th>
                           <th>Guests</th>
                           <th>Total Amount</th>
                        </tr>
                     </thead>
                     <tbody>
                        <tr>
                           <td>
                              <%= tourTitle %>
                           </td>
                           <td>
                              <%= guestCount %>
                           </td>
                           <td>$<%= totalAmount.toFixed(2) %>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <div class="total">
                     Grand Total: $<%= totalAmount.toFixed(2) %>
                  </div>
               </div>

               <!-- Footer -->
               <div class="footer">
                  Thank you for booking with us.<br>
                  © <%= new Date().getFullYear() %> Your Company
               </div>
            </div>
         </td>
      </tr>
   </table>
</body>

</html>